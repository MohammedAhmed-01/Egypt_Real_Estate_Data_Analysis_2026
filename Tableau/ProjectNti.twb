          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#1e2a5e' fontsize='20'>Yield By Town</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Listings+ (Multiple Connections)' name='federated.0c190k60s5mqis18uwpm70rq58gt' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.0c190k60s5mqis18uwpm70rq58gt'>
            <column caption='Quarter-Year Label  ' datatype='string' name='[Calculation_1435717608857608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [listed_date])) + &quot; &quot; + STR(YEAR([listed_date]))' />
            </column>
            <column caption='Buy Median Price by City' datatype='real' name='[Calculation_1435717615157266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [city] : MEDIAN(IF [offering_type]=&quot;Buy&quot; THEN [price_egp] END) }' />
            </column>
            <column caption='Rent Count by Town' datatype='integer' name='[Calculation_1435717615329299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [city], [town] : SUM(IF [offering_type]=&quot;Rent&quot; THEN 1 ELSE 0 END) }' />
            </column>
            <column caption='Buy Count by Town' datatype='integer' name='[Calculation_1435717615452180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [city], [town] : SUM(IF [offering_type]=&quot;Buy&quot; THEN 1 ELSE 0 END) }' />
            </column>
            <column caption='Rent Median Price by City' datatype='real' name='[Calculation_1435717615546389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [city] : MEDIAN(IF [offering_type]=&quot;Rent&quot; THEN [price_egp] END) }' />
            </column>
            <column caption='Annual Yield by City %' datatype='real' name='[Calculation_1435717616230422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1435717615546389] * 12) / [Calculation_1435717615157266] * 100' />
            </column>
            <column caption='Calculation1' datatype='boolean' name='[Calculation_1435717685977158]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1435717615452180] &gt;= 10 AND [Calculation_1435717615329299] &gt;= 10' />
            </column>
