            <column-instance column='[Calculation_1435717609902095]' derivation='None' name='[none:Calculation_1435717609902095:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[offering_type]' derivation='None' name='[none:offering_type:nk]' pivot='key' type='nominal' />
            <column caption='Offering Type' datatype='string' name='[offering_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0c190k60s5mqis18uwpm70rq58gt].[Action (Quarter-Year Label  )]' filter-group='3'>
