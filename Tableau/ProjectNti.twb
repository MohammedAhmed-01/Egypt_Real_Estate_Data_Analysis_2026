    <worksheet name='QUARTERLY PRICE TREND'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#1e2a5e' fontsize='20'>Quarterly Price Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Listings+ (Multiple Connections)' name='federated.0c190k60s5mqis18uwpm70rq58gt' />
          </datasources>
          <datasource-dependencies datasource='federated.0c190k60s5mqis18uwpm70rq58gt'>
            <column caption='Quarter-Year Label  ' datatype='string' name='[Calculation_1435717608857608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [listed_date])) + &quot; &quot; + STR(YEAR([listed_date]))' />
            </column>
            <column caption='Quarter-Year Sort Key ' datatype='integer' name='[Calculation_1435717609037833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR([listed_date]) * 10 + DATEPART(&apos;quarter&apos;, [listed_date])' />
            </column>
            <column caption='Buy Price SQM Chart  ' datatype='real' name='[Calculation_1435717617897503]' role='measure' type='quantitative'>
