      <column caption='PRICE PER SQM' datatype='real' name='[Calculation_1435717606477824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[price_egp] / [area_value]' />
      </column>
      <column caption='Log Price' datatype='real' name='[Calculation_1435717606948865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([price_egp])' />
      </column>
      <column caption='Log Area' datatype='real' name='[Calculation_1435717607190530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([area_value])' />
      </column>
      <column caption='Month Number        ' datatype='integer' name='[Calculation_1435717607833603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MONTH([listed_date])' />
      </column>
      <column caption='Month Name              ' datatype='string' name='[Calculation_1435717608058884]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [listed_date])' />
      </column>
      <column caption='Month-Year Label ' datatype='string' name='[Calculation_1435717608271877]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [listed_date]) + &quot; &quot; + STR(YEAR([listed_date]))' />
      </column>
      <column caption='Month-Year Sort Key ' datatype='integer' name='[Calculation_1435717608419334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([listed_date]) * 100 + MONTH([listed_date])' />
      </column>
      <column caption='Quarter Number ' datatype='integer' name='[Calculation_1435717608660999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;quarter&apos;, [listed_date])' />
      </column>
      <column caption='Quarter-Year Label  ' datatype='string' name='[Calculation_1435717608857608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [listed_date])) + &quot; &quot; + STR(YEAR([listed_date]))' />
      </column>
      <column caption='Quarter-Year Sort Key ' datatype='integer' name='[Calculation_1435717609037833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([listed_date]) * 10 + DATEPART(&apos;quarter&apos;, [listed_date])' />
      </column>
      <column caption='Day of Week Name  ' datatype='string' name='[Calculation_1435717609259018]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [listed_date])' />
      </column>
      <column caption='Day of Week Number ' datatype='integer' name='[Calculation_1435717609377803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [listed_date])' />
      </column>
      <column caption='Week Number' datatype='integer' name='[Calculation_1435717609500684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;week&apos;, [listed_date])' />
      </column>
      <column caption='Year  ' datatype='integer' name='[Calculation_1435717609615373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([listed_date])' />
      </column>
      <column caption='Season' datatype='string' name='[Calculation_1435717609762830]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([listed_date]) IN (12, 1, 2) THEN &quot;Winter&quot;&#13;&#10;ELSEIF MONTH([listed_date]) IN (3, 4, 5) THEN &quot;Spring&quot;&#13;&#10;ELSEIF MONTH([listed_date]) IN (6, 7, 8) THEN &quot;Summer&quot;&#13;&#10;ELSE &quot;Autumn&quot;&#13;&#10;END' />
      </column>
      <column caption='Month Period' datatype='string' name='[Calculation_1435717609902095]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DAY([listed_date]) &lt;= 10 THEN &quot;Beginning&quot;&#13;&#10;ELSEIF DAY([listed_date]) &lt;= 20 THEN &quot;Middle&quot;&#13;&#10;ELSE &quot;End&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Band Buy' datatype='string' name='[Calculation_1435717614735376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [offering_type] = &quot;Buy&quot; THEN&#13;&#10;  IF [price_egp] &lt; 5000000 THEN &quot;Under 5M&quot;&#13;&#10;  ELSEIF [price_egp] &lt; 15000000 THEN &quot;5M-15M&quot;&#13;&#10;  ELSE &quot;Above 15M&quot;&#13;&#10;  END&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Price Band Rent' datatype='string' name='[Calculation_1435717614948369]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [offering_type] = &quot;Rent&quot; THEN&#13;&#10;  IF [price_egp] &lt; 10000 THEN &quot;Under 10K&quot;&#13;&#10;  ELSEIF [price_egp] &lt; 50000 THEN &quot;10K-50K&quot;&#13;&#10;  ELSE &quot;Above 50K&quot;&#13;&#10;  END&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Buy Median Price by City' datatype='real' name='[Calculation_1435717615157266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city] : MEDIAN(IF [offering_type]=&quot;Buy&quot; THEN [price_egp] END) }' />
      </column>
      <column caption='Rent Count by Town' datatype='integer' name='[Calculation_1435717615329299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city], [town] : SUM(IF [offering_type]=&quot;Rent&quot; THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Buy Count by Town' datatype='integer' name='[Calculation_1435717615452180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city], [town] : SUM(IF [offering_type]=&quot;Buy&quot; THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Rent Median Price by City' datatype='real' name='[Calculation_1435717615546389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city] : MEDIAN(IF [offering_type]=&quot;Rent&quot; THEN [price_egp] END) }' />
      </column>
      <column caption='Annual Yield by City %' datatype='real' name='[Calculation_1435717616230422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1435717615546389] * 12) / [Calculation_1435717615157266] * 100' />
      </column>
      <column caption='Buy Median Price by Town' datatype='real' name='[Calculation_1435717616427031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city], [town] : MEDIAN(IF [offering_type]=&quot;Buy&quot; THEN [price_egp] END) }' />
      </column>
      <column caption='Rent Median Price by Town' datatype='real' name='[Calculation_1435717616554008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city], [town] : MEDIAN(IF [offering_type]=&quot;Rent&quot; THEN [price_egp] END) }' />
      </column>
